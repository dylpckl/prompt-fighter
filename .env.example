# All server-side. Nothing here reaches the browser — the client calls
# same-origin /api routes and never talks to Supabase or Anthropic directly.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Only used by `npm run seed`. Point it at a deployed URL to fill that pool.
SEED_BASE_URL=http://localhost:3000

# Optional. Global cap on model calls per 24 hours, across all players.
# GENERATIONS_PER_DAY=500

# Optional. Public URL of the site, for absolute share-preview links. On Vercel
# the production domain is used when this is unset.
# SITE_URL=https://prompt-fighter.example
